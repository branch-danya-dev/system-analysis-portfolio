@startuml
title Technical Competency Map

skinparam shadowing false
skinparam roundcorner 18
skinparam defaultTextAlignment center
skinparam ArrowColor #8B949E
skinparam ArrowThickness 1.2

skinparam rectangle {
  BackgroundColor #0D1117
  BorderColor #30363D
  FontColor #F0F6FC
}

rectangle "REQUIREMENTS\nBPMN · Business Rules · AC" as REQ
rectangle "DATA\nSQL · JSON · ERD" as DATA
rectangle "SYSTEM ANALYSIS" as SA
rectangle "SYSTEM DESIGN\nUML · API · Integrations" as DESIGN
rectangle "IMPLEMENTATION\nC# · Flutter · React · Python" as DEV
rectangle "DELIVERY\nDocker · Git · Postman · Jira" as DELIVERY

REQ -down-> SA
DATA -right-> SA
SA -right-> DESIGN
SA -down-> DEV
DEV -down-> DELIVERY

@enduml
